# Where the API listens. Keep it on loopback unless a reverse proxy sits in front.
HOST=127.0.0.1
PORT=8787

# The browser origin allowed to call this API with cookies.
FRONTEND_ORIGIN=http://localhost:5173

# Set to false only for plain-http local development.
COOKIE_SECURE=false

# Where per-user homepage layouts are written (one JSON file per user).
DATA_DIR=data

# Session lifetime in milliseconds (default 30 days). Sessions slide while in use and
# are persisted to DATA_DIR/sessions.json (owner-only file) so restarts keep users signed in.
SESSION_TTL_MS=2592000000

# Sign-in page: users enter their ThoughtSpot cluster URL, username and password.
# The backend logs in with auth/session/login and keeps the cluster cookies in the
# server-side session. Any http(s) origin is accepted: hostnames, IPs, localhost, ports.
# Dev clusters with a self-signed certificate: give Node the CA file (verification stays on):
#   NODE_EXTRA_CA_CERTS=/path/to/cluster-ca.pem pnpm dev

# --- Optional extra ways to authenticate (dev tokens / pre-minted cluster tokens) ---

# 1. Real users: a token presented at sign-in is checked against this
#    ThoughtSpot instance (GET /api/rest/2.0/auth/session/user). Must be https.
# THOUGHTSPOT_HOST=https://your-instance.thoughtspot.cloud

# 2. Local development: static tokens mapped to fake users. JSON array.
# Local development only: skip the sign-in page and act as this dev user id.
# Leave commented to get the real sign-in page (cluster URL, username, password).
# DEV_DEFAULT_USER=alice

DEV_USERS=[{"token":"dev-alice-token","id":"alice","name":"alice","displayName":"Alice"},{"token":"dev-bob-token","id":"bob","name":"bob","displayName":"Bob"}]

# --- Spotter chat (optional) ---
# OpenAI-compatible LLM gateway. Without these the chat bar answers "chat disabled".
# The key usually lives in the repo-root .env (also loaded); never commit it.
# API_GATEWAY_KEY=...
# LLM_GATEWAY_URL=https://your-llm-gateway.example/v1
# LLM_MODEL=kimi-k3
