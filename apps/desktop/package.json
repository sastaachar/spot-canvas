{
  "name": "@spot-canvas/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Spot Canvas desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && SPOT_CANVAS_DEV_URL=http://localhost:5173 electron .",
    "start": "tsc -p tsconfig.json && electron ."
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "electron": "44.4.3",
    "typescript": "7.0.2"
  }
}
