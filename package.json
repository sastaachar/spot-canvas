{
  "name": "spot-canvas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.10.5",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @spot-canvas/frontend --filter @spot-canvas/backend dev",
    "dev:frontend": "pnpm --filter @spot-canvas/frontend dev",
    "dev:backend": "pnpm --filter @spot-canvas/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
